{
  "name": "academic-army",
  "version": "0.1.0",
  "description": "Agent workflows and skills for AcademicArmy.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "typecheck": "npm run check",
    "lint": "eslint .",
    "format": "prettier \"src/**/*.ts\" \"*.{js,json}\" \".*.json\" --write",
    "format:check": "prettier \"src/**/*.ts\" \"*.{js,json}\" \".*.json\" --check",
    "cli": "tsx src/cli.ts",
    "developing-loop": "tsx src/cli.ts developing",
    "evolve-skill": "tsx src/cli.ts evolve-skill"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.134.0",
    "coding-agent-forge": "^1.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
