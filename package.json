{
  "name": "academic-army",
  "version": "0.4.1",
  "description": "Agent workflows and skills for AcademicArmy.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yindaheng98/AcademicArmy"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    "./evolve-skill": {
      "types": "./dist/evolve-skill/index.d.ts",
      "import": "./dist/evolve-skill/index.js"
    }
  },
  "files": [
    "dist",
    "agent-forge.yaml",
    "skills",
    "metaskills",
    "runs",
    "mcp-server/__main__.py",
    "mcp-server/requirements.txt",
    "mcp-server/deepresearch/*.py",
    "mcp-server/writing_master/*.py",
    "install_mcp.py",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "typecheck": "npm run check",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "dev": "tsx src/cli.ts",
    "cli": "tsx src/cli.ts",
    "developing": "tsx src/cli.ts developing",
    "developing-skill": "tsx src/cli.ts developing-skill",
    "evolve-skill": "tsx src/cli.ts evolve-skill"
  },
  "dependencies": {
    "coding-agent-forge": ">=1.3.5",
    "developing-agent-forge": ">=2.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
