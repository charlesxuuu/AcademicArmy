{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeepResearchReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "research_summary",
    "user_idea_interpretation",
    "referenced_papers",
    "closest_existing_work",
    "code_datasets_benchmarks_artifacts",
    "venue_or_journal_implications",
    "gap_analysis",
    "contribution_framing_advice",
    "claim_strength_recommendation",
    "evaluation_recommendation",
    "recommended_blueprint_decisions",
    "uncertainties_and_tbd"
  ],
  "properties": {
    "research_summary": { "type": "string" },
    "user_idea_interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interpreted_problem",
        "interpreted_method",
        "interpreted_claim",
        "interpretation_confidence"
      ],
      "properties": {
        "interpreted_problem": { "type": "string" },
        "interpreted_method": { "type": "string" },
        "interpreted_claim": { "type": "string" },
        "interpretation_confidence": { "type": "string", "enum": ["low", "medium", "high"] }
      }
    },
    "referenced_papers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference_id",
          "title",
          "authors",
          "year",
          "venue_or_source",
          "url_or_doi",
          "citation_signal",
          "relevance",
          "influence_on_blueprint",
          "limitations"
        ],
        "properties": {
          "reference_id": { "type": "string" },
          "title": { "type": "string" },
          "authors": { "type": "string" },
          "year": { "type": "string" },
          "venue_or_source": { "type": "string" },
          "url_or_doi": { "type": "string" },
          "citation_signal": { "type": "string" },
          "relevance": { "type": "string" },
          "influence_on_blueprint": { "type": "array", "items": { "type": "string" } },
          "limitations": { "type": "string" }
        }
      }
    },
    "closest_existing_work": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference_id", "why_close", "how_user_idea_differs", "risk_if_not_addressed"],
        "properties": {
          "reference_id": { "type": "string" },
          "why_close": { "type": "string" },
          "how_user_idea_differs": { "type": "string" },
          "risk_if_not_addressed": { "type": "string" }
        }
      }
    },
    "code_datasets_benchmarks_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "name",
          "type",
          "url",
          "owner_or_maintainer",
          "relevance",
          "license_or_availability",
          "caution"
        ],
        "properties": {
          "artifact_id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["code", "dataset", "benchmark", "tool", "protocol", "other"] },
          "url": { "type": "string" },
          "owner_or_maintainer": { "type": "string" },
          "relevance": { "type": "string" },
          "license_or_availability": { "type": "string" },
          "caution": { "type": "string" }
        }
      }
    },
    "venue_or_journal_implications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "source_ids", "expectations", "constraints", "blueprint_implications"],
      "properties": {
        "target": { "type": "string" },
        "source_ids": { "type": "array", "items": { "type": "string" } },
        "expectations": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "blueprint_implications": { "type": "array", "items": { "type": "string" } }
      }
    },
    "gap_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["established_area", "open_gap", "why_gap_is_relevant", "confidence"],
      "properties": {
        "established_area": { "type": "string" },
        "open_gap": { "type": "string" },
        "why_gap_is_relevant": { "type": "string" },
        "confidence": { "type": "string", "enum": ["low", "medium", "high"] }
      }
    },
    "contribution_framing_advice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended_contributions", "contributions_to_avoid"],
      "properties": {
        "recommended_contributions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim", "basis", "rationale", "risk"],
            "properties": {
              "claim": { "type": "string" },
              "basis": {
                "type": "string",
                "enum": ["user_provided", "deepresearch_supported", "needs_user_confirmation"]
              },
              "rationale": { "type": "string" },
              "risk": { "type": "string" }
            }
          }
        },
        "contributions_to_avoid": { "type": "array", "items": { "type": "string" } }
      }
    },
    "claim_strength_recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "main_claim",
        "conservative_version",
        "strong_version",
        "recommended_strength",
        "rationale"
      ],
      "properties": {
        "main_claim": { "type": "string" },
        "conservative_version": { "type": "string" },
        "strong_version": { "type": "string" },
        "recommended_strength": { "type": "string", "enum": ["conservative", "moderate", "strong"] },
        "rationale": { "type": "string" }
      }
    },
    "evaluation_recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_goal",
        "baselines_or_comparisons",
        "metrics",
        "quantitative_checks",
        "qualitative_checks",
        "ablation_or_sensitivity_checks",
        "risks"
      ],
      "properties": {
        "evaluation_goal": { "type": "string" },
        "baselines_or_comparisons": { "type": "array", "items": { "type": "string" } },
        "metrics": { "type": "array", "items": { "type": "string" } },
        "quantitative_checks": { "type": "array", "items": { "type": "string" } },
        "qualitative_checks": { "type": "array", "items": { "type": "string" } },
        "ablation_or_sensitivity_checks": { "type": "array", "items": { "type": "string" } },
        "risks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "recommended_blueprint_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["blueprint_section", "decision", "rationale", "source_ids", "confidence"],
        "properties": {
          "blueprint_section": { "type": "string" },
          "decision": { "type": "string" },
          "rationale": { "type": "string" },
          "source_ids": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "string", "enum": ["low", "medium", "high"] }
        }
      }
    },
    "uncertainties_and_tbd": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "reason", "needed_from_user"],
        "properties": {
          "item": { "type": "string" },
          "reason": { "type": "string" },
          "needed_from_user": { "type": "string" }
        }
      }
    }
  }
}
