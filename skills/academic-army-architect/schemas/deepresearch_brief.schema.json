{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeepResearchBrief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_mode",
    "conversation_language",
    "user_goal",
    "deepresearch_question_type",
    "user_idea_summary",
    "known_information",
    "existing_blueprint",
    "revision_request",
    "missing_information",
    "blueprint_sections_under_review",
    "deepresearch_questions",
    "required_source_types",
    "integration_instructions",
    "output_format"
  ],
  "properties": {
    "task_mode": {
      "type": "string",
      "enum": [
        "new_blueprint_from_incomplete_idea",
        "new_blueprint_from_complete_plan",
        "revise_existing_blueprint",
        "rebase_to_new_venue_or_journal",
        "fine_edit_existing_blueprint"
      ]
    },
    "conversation_language": { "type": "string" },
    "user_goal": { "type": "string" },
    "deepresearch_question_type": {
      "type": "string",
      "enum": [
        "general_blueprint_judgment",
        "venue_style_analysis",
        "related_direction_synthesis",
        "closest_work_comparison",
        "contribution_boundary",
        "claim_strength",
        "method_evaluation_design",
        "artifact_landscape",
        "paper_structure_strategy",
        "revision_impact_analysis"
      ]
    },
    "user_idea_summary": { "type": "string" },
    "known_information": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "subfield",
        "target_venue_or_journal",
        "paper_type",
        "research_problem",
        "method_or_approach",
        "existing_evidence",
        "available_data_or_artifacts",
        "constraints"
      ],
      "properties": {
        "field": { "type": "string" },
        "subfield": { "type": "string" },
        "target_venue_or_journal": { "type": "string" },
        "paper_type": { "type": "string" },
        "research_problem": { "type": "string" },
        "method_or_approach": { "type": "string" },
        "existing_evidence": { "type": "string" },
        "available_data_or_artifacts": { "type": "string" },
        "constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "existing_blueprint": { "type": ["string", "null"] },
    "revision_request": { "type": ["string", "null"] },
    "missing_information": { "type": "array", "items": { "type": "string" } },
    "blueprint_sections_under_review": { "type": "array", "items": { "type": "string" } },
    "deepresearch_questions": { "type": "array", "items": { "type": "string" } },
    "required_source_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["papers", "code", "datasets", "benchmarks", "venue_guidelines", "artifacts"]
      }
    },
    "integration_instructions": { "type": "array", "items": { "type": "string" } },
    "output_format": { "type": "string" }
  }
}
