{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeepResearchPaperBlueprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "basic_information",
    "research_idea_summary",
    "target_paper_type",
    "target_venue_or_journal",
    "research_problem",
    "motivation",
    "central_claim",
    "research_questions",
    "proposed_contribution",
    "method_or_approach",
    "data_materials_or_artifacts",
    "evaluation_or_validation_plan",
    "related_work_positioning",
    "paper_structure",
    "missing_information_and_next_actions"
  ],
  "properties": {
    "basic_information": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "subfield",
        "paper_type",
        "target_venue_or_journal",
        "target_readers",
        "current_stage",
        "blueprint_version"
      ],
      "properties": {
        "field": { "type": "string" },
        "subfield": { "type": "string" },
        "paper_type": { "type": "string" },
        "target_venue_or_journal": { "type": "string" },
        "target_readers": { "type": "string" },
        "current_stage": { "type": "string" },
        "blueprint_version": { "type": "string" }
      }
    },
    "research_idea_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["one_sentence_summary", "expanded_summary"],
      "properties": {
        "one_sentence_summary": { "type": "string" },
        "expanded_summary": { "type": "string" }
      }
    },
    "target_paper_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_paper_type", "secondary_paper_type", "reason"],
      "properties": {
        "primary_paper_type": { "type": "string" },
        "secondary_paper_type": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "target_venue_or_journal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "venue_expectations", "fit_considerations", "constraints"],
      "properties": {
        "name": { "type": "string" },
        "venue_expectations": { "type": "array", "items": { "type": "string" } },
        "fit_considerations": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "research_problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem", "context", "existing_difficulty", "why_this_problem_matters"],
      "properties": {
        "problem": { "type": "string" },
        "context": { "type": "string" },
        "existing_difficulty": { "type": "string" },
        "why_this_problem_matters": { "type": "string" }
      }
    },
    "motivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["academic_motivation", "practical_motivation", "why_now"],
      "properties": {
        "academic_motivation": { "type": "string" },
        "practical_motivation": { "type": "string" },
        "why_now": { "type": "string" }
      }
    },
    "central_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["main_claim", "scoped_version", "strong_version", "claim_scope"],
      "properties": {
        "main_claim": { "type": "string" },
        "scoped_version": { "type": "string" },
        "strong_version": { "type": "string" },
        "claim_scope": { "type": "string" }
      }
    },
    "research_questions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "string" }
    },
    "proposed_contribution": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "string" }
    },
    "method_or_approach": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_method", "key_mechanism", "input", "output", "assumptions", "scope", "non_goals"],
      "properties": {
        "core_method": { "type": "string" },
        "key_mechanism": { "type": "string" },
        "input": { "type": "string" },
        "output": { "type": "string" },
        "assumptions": { "type": "string" },
        "scope": { "type": "string" },
        "non_goals": { "type": "string" }
      }
    },
    "data_materials_or_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_corpus_or_case", "code_system_or_tool", "benchmark", "external_resources", "availability", "constraints"],
      "properties": {
        "dataset_corpus_or_case": { "type": "string" },
        "code_system_or_tool": { "type": "string" },
        "benchmark": { "type": "string" },
        "external_resources": { "type": "array", "items": { "type": "string" } },
        "availability": { "type": "string" },
        "constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evaluation_or_validation_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_goal",
        "baselines_or_comparisons",
        "metrics",
        "quantitative_evaluation",
        "qualitative_evaluation",
        "ablation_or_sensitivity_analysis",
        "robustness_or_generalization_check"
      ],
      "properties": {
        "evaluation_goal": { "type": "string" },
        "baselines_or_comparisons": { "type": "string" },
        "metrics": { "type": "string" },
        "quantitative_evaluation": { "type": "string" },
        "qualitative_evaluation": { "type": "string" },
        "ablation_or_sensitivity_analysis": { "type": "string" },
        "robustness_or_generalization_check": { "type": "string" }
      }
    },
    "related_work_positioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_anchors", "closest_existing_work", "differentiation", "gap", "positioning_statement"],
      "properties": {
        "reference_anchors": { "type": "array", "items": { "type": "string" } },
        "closest_existing_work": { "type": "array", "items": { "type": "string" } },
        "differentiation": { "type": "string" },
        "gap": { "type": "string" },
        "positioning_statement": { "type": "string" }
      }
    },
    "paper_structure": {
      "type": "array",
      "minItems": 8,
      "items": { "type": "string" }
    },
    "missing_information_and_next_actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missing_information", "user_decisions_needed", "next_writing_actions"],
      "properties": {
        "missing_information": { "type": "array", "items": { "type": "string" } },
        "user_decisions_needed": { "type": "array", "items": { "type": "string" } },
        "next_writing_actions": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
