{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PaperBlueprintSourceLedger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blueprint_id",
    "version",
    "created_at",
    "updated_at",
    "conversation_language",
    "mode",
    "user_inputs",
    "deepresearch_runs",
    "assumptions",
    "changes"
  ],
  "properties": {
    "blueprint_id": { "type": "string" },
    "version": { "type": "string" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "conversation_language": { "type": "string" },
    "mode": {
      "type": "string",
      "enum": [
        "new_blueprint_from_incomplete_idea",
        "new_blueprint_from_complete_plan",
        "revise_existing_blueprint",
        "rebase_to_new_venue_or_journal",
        "fine_edit_existing_blueprint"
      ]
    },
    "user_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["turn_id", "summary"],
        "properties": {
          "turn_id": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "deepresearch_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "purpose",
          "question_type",
          "brief_summary",
          "date",
          "report_path",
          "sources_consulted",
          "recommended_blueprint_decisions"
        ],
        "properties": {
          "run_id": { "type": "string" },
          "purpose": { "type": "string" },
          "question_type": {
            "type": "string",
            "enum": [
              "general_blueprint_judgment",
              "venue_style_analysis",
              "related_direction_synthesis",
              "closest_work_comparison",
              "contribution_boundary",
              "claim_strength",
              "method_evaluation_design",
              "artifact_landscape",
              "paper_structure_strategy",
              "revision_impact_analysis"
            ]
          },
          "brief_summary": { "type": "string" },
          "date": { "type": "string" },
          "report_path": { "type": "string" },
          "sources_consulted": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "type",
                "title",
                "url",
                "year",
                "venue",
                "citation_signal",
                "used_in_blueprint_sections"
              ],
              "properties": {
                "source_id": { "type": "string" },
                "type": {
                  "type": "string",
                  "enum": [
                    "paper",
                    "code",
                    "dataset",
                    "benchmark",
                    "venue_guideline",
                    "documentation",
                    "other_artifact"
                  ]
                },
                "title": { "type": "string" },
                "url": { "type": "string" },
                "year": { "type": "string" },
                "venue": { "type": "string" },
                "citation_signal": { "type": "string" },
                "used_in_blueprint_sections": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "recommended_blueprint_decisions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["blueprint_section", "decision", "confidence"],
              "properties": {
                "blueprint_section": { "type": "string" },
                "decision": { "type": "string" },
                "confidence": { "type": "string", "enum": ["low", "medium", "high"] }
              }
            }
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assumption_id", "content", "confidence", "where_used"],
        "properties": {
          "assumption_id": { "type": "string" },
          "content": { "type": "string" },
          "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
          "where_used": { "type": "string" }
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "change_request",
          "sections_changed",
          "new_sources_added",
          "old_sources_removed",
          "deepresearch_run_ids"
        ],
        "properties": {
          "version": { "type": "string" },
          "change_request": { "type": "string" },
          "sections_changed": { "type": "array", "items": { "type": "string" } },
          "new_sources_added": { "type": "array", "items": { "type": "string" } },
          "old_sources_removed": { "type": "array", "items": { "type": "string" } },
          "deepresearch_run_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
