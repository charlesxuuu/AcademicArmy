{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PaperBlueprintSourceLedger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blueprint_id",
    "version",
    "created_at",
    "updated_at",
    "conversation_language",
    "mode",
    "user_inputs",
    "searches",
    "assumptions",
    "changes"
  ],
  "properties": {
    "blueprint_id": { "type": "string" },
    "version": { "type": "string" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "conversation_language": { "type": "string" },
    "mode": {
      "type": "string",
      "enum": [
        "new_blueprint_from_incomplete_idea",
        "new_blueprint_from_complete_plan",
        "revise_existing_blueprint",
        "rebase_to_new_venue_or_journal",
        "fine_edit_existing_blueprint"
      ]
    },
    "user_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["turn_id", "summary"],
        "properties": {
          "turn_id": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "searches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["search_id", "purpose", "query", "date", "sources_consulted"],
        "properties": {
          "search_id": { "type": "string" },
          "purpose": { "type": "string" },
          "query": { "type": "string" },
          "date": { "type": "string" },
          "sources_consulted": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "type",
                "title",
                "url",
                "year",
                "venue",
                "citation_signal",
                "used_in_blueprint_sections"
              ],
              "properties": {
                "source_id": { "type": "string" },
                "type": {
                  "type": "string",
                  "enum": [
                    "paper",
                    "code",
                    "dataset",
                    "benchmark",
                    "venue_guideline",
                    "documentation",
                    "other_artifact"
                  ]
                },
                "title": { "type": "string" },
                "url": { "type": "string" },
                "year": { "type": "string" },
                "venue": { "type": "string" },
                "citation_signal": { "type": "string" },
                "used_in_blueprint_sections": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assumption_id", "content", "confidence", "where_used"],
        "properties": {
          "assumption_id": { "type": "string" },
          "content": { "type": "string" },
          "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
          "where_used": { "type": "string" }
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "change_request",
          "sections_changed",
          "new_sources_added",
          "old_sources_removed"
        ],
        "properties": {
          "version": { "type": "string" },
          "change_request": { "type": "string" },
          "sections_changed": { "type": "array", "items": { "type": "string" } },
          "new_sources_added": { "type": "array", "items": { "type": "string" } },
          "old_sources_removed": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
